# Dialy environment configuration
# Copy this file to ".env" and fill in your own values.
# Everything here is OPTIONAL – without it the app runs fully offline.
#
# Only EXPO_PUBLIC_* values reach the app, and they must be client-safe
# (public). NEVER give a Supabase service-role key or any database
# credentials an EXPO_PUBLIC_ name.

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional crash reporting – no-op when empty)
EXPO_PUBLIC_SENTRY_DSN=

# Shown in the Kontakt form when a message cannot be sent (offline). Empty = placeholder.
EXPO_PUBLIC_CONTACT_EMAIL=

# Feature flags (default off). Set to "true" to enable.
EXPO_PUBLIC_FEATURE_HEALTH=false

# Dialy-Editor only (npm run editor, tab "Backup"): lets the local editor
# server back up and restore user accounts and their data. Secret - Supabase
# -> Settings -> API -> service_role. Never used by the app.
SUPABASE_SERVICE_ROLE_KEY=
