# Dialy environment configuration
# Copy this file to ".env" and fill in your own values.
# Everything here is OPTIONAL – without it the app runs fully offline.
#
# Only client-safe (public) values belong here. NEVER add a Supabase
# service-role key or any database credentials to the client.

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (optional crash reporting – no-op when empty)
EXPO_PUBLIC_SENTRY_DSN=

# Feature flags (default off). Set to "true" to enable.
EXPO_PUBLIC_FEATURE_FCM=false
EXPO_PUBLIC_FEATURE_HEALTH=false
